+def segment_video_thresholds(config: dict, video: Path, output_low: Path, output_high: Path) -> None:
+    width, height, n_frames = ffprobe(video)
+    if (width, height) != (1920, 1080):
+        raise ValueError(f"unexpected dimensions: {(width, height)}")
+    seg = Segmenter(config, width, height)
+    masks_low, masks_high, scores = [], [], []
+    eligible = None
+    low, high = config["sensitivity"]["occupied_pixels_per_grid_cell"]
+    for idx, frame in raw_frames(video):
+        mask, score = seg.mask(frame, "A")
+        _, grid_score, eligible, counts = seg.grid(mask, score)
+        masks_low.append(counts >= low)
+        masks_high.append(counts >= high)
+        scores.append(grid_score)
+        if idx and idx % 100 == 0:
+            print(f"{video.name}: {idx}/{n_frames}", flush=True)
+    common = {
+        "scores": np.stack(scores).astype(np.uint8),
+        "eligible": eligible.astype(np.uint8),
+        "source_video": np.asarray(video.name),
+        "sensitivity_code_sha256": np.asarray(sha256_file(Path(__file__))),
+    }
+    np.savez_compressed(output_low, masks=np.stack(masks_low).astype(np.uint8), threshold=np.asarray(low), **common)
+    np.savez_compressed(output_high, masks=np.stack(masks_high).astype(np.uint8), threshold=np.asarray(high), **common)
