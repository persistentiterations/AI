{
  "name": "declared_context_scoping_gate",
  "philosophy": "A memory grounds a decision only in the context it was grounded in; a contradiction blocks only in the context it was raised in (or globally). Context is part of identity, not a luxury.",
  "layers": {
    "adapter": "baby_ai/adapters/operational_self.py::route_decision accepts context: str|None; mem_contexts/scar_contexts/scar_kinds recorded at ingest from event provenance; _applicable_results and _blocking_scars_for admit only (own ctx OR global '*'); _cause_for_block maps scar origin (MARK -> active_contradiction, SUPERSECRE HOLD -> declared_prohibition) and adds evidence_missing when nothing grounds a RELEASE inside the query's context",
    "representation": "baby_ai/ladder/representations.py::HistoricalFractalish.apply threads op ctx + op_kind into event provenance before ingest; HistoricalFractalish.route passes the query's ctx keyword through; context_gate class flag toggles the dimension for the causal ablation",
    "retrieval": "baby_ai/fractalish-ai/.../retrieval.py (UNMODIFIED, read-only upstream)"
  },
  "structural_reads": {
    "identity": "stable memory_id (unchanged)",
    "grounding_context": "event provenance context recorded on each memory/scar at ingest",
    "declared_context": "the router receives the query's ctx and admits records only if (record ctx == query ctx OR record ctx == global '*')",
    "scar_origin": "op_kind (FORM/MARK/SUPERSEDE/...) recorded on each scar so the blocked cause is precise"
  },
  "no_lexical_patch": "no context-name special cases, no threshold tuning, no substring exclusions; gate keys on context identity equality and the global marker only.",
